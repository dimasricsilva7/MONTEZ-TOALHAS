# ─────────────────────────────────────────────────────────────
# MONTEZ — variáveis de ambiente (NUNCA coloque valores reais neste arquivo)
# Produção: Vercel → Project → Settings → Environment Variables
# Local: copie para .env (ignorado pelo git)
# Segredos NUNCA usam o prefixo NEXT_PUBLIC_ (esse prefixo expõe ao navegador).
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL (Neon / Supabase / Vercel Postgres)
DATABASE_URL=              # conexão com pooler
DATABASE_URL_UNPOOLED=     # conexão direta (migrations). Pode ser igual à DATABASE_URL

# Supabase (opcional — só se usar Supabase como provedor do Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # segredo: somente servidor

# URL pública (sem barra no final). Trocar ao ligar o domínio próprio.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Segredos internos (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=               # hash de IP (LGPD) e assinaturas internas
CRON_SECRET=               # protege /api/cron/* (Vercel Cron e GitHub Actions enviam Bearer)

# BravoPay (https://bravopay.club/docs) — somente servidor
BRAVOPAY_API_KEY=          # bp_live_...  (Dashboard BravoPay → API Keys)
BRAVOPAY_WEBHOOK_SECRET=   # whsec_...    (Dashboard BravoPay → Webhooks; URL: <SITE>/api/webhooks/bravopay)
BRAVOPAY_PRODUCT_ID=       # opcional: ID do produto na BravoPay (atribuição UTMify)
BRAVOPAY_BASE_URL=https://bravopay.club/api/v1
# BRAVOPAY_MODE=mock       # apenas desenvolvimento/preview: PIX fictício, sem cobrança. Ignorado em produção.

# E-mail transacional
EMAIL_PROVIDER=            # resend | smtp | console (console = só log, para desenvolvimento)
EMAIL_FROM=                # ex.: MONTEZ <pedidos@seudominio.com.br> (domínio verificado no provedor)
EMAIL_REPLY_TO=            # ex.: atendimento@seudominio.com.br
EMAIL_API_KEY=             # chave da Resend (se EMAIL_PROVIDER=resend)
SMTP_HOST=                 # se EMAIL_PROVIDER=smtp
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Armazenamento de imagens (Vercel Blob — criado automaticamente ao conectar um Blob Store ao projeto)
BLOB_READ_WRITE_TOKEN=

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=             # ID numérico do Pixel (público por natureza)
NEXT_PUBLIC_META_PIXEL_ID_SECONDARY=   # opcional: segundo Pixel — só se realmente necessário
META_CONVERSIONS_API_TOKEN=            # segredo: token da CAPI (Gerenciador de Eventos → Configurações)
META_CONVERSIONS_API_TOKEN_SECONDARY=  # opcional: token do Pixel secundário (senão usa o principal)
META_TEST_EVENT_CODE=                  # opcional: TEST12345 para ver eventos em "Eventos de teste"

# Google Analytics 4 (opcional — desativado se vazio)
NEXT_PUBLIC_GA_MEASUREMENT_ID=         # G-XXXXXXXXXX

# Admin (primeiro acesso). Depois do primeiro login a senha pode ser trocada no painel.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=       # bcrypt: npm run admin:hash -- "senha forte". Em .env local, escape os $ como \$

# Otimização de imagens da Vercel (opcional: "on" para ativar se houver cota no plano)
IMAGE_OPTIMIZATION=
